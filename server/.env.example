# Copy this file to .env and fill in the values.

# --- Used now ---------------------------------------------------------------
NODE_ENV=development
PORT=4000

# The React app's address, allowed by CORS
CLIENT_URL=http://localhost:5173

# MySQL connection: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root:password@localhost:3306/unigo

# How long to wait for a database connection before giving up (milliseconds)
DATABASE_CONNECT_TIMEOUT_MS=3000

# JWT signing secrets: at least 32 characters each, and different from each other.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Token lifetimes: a number followed by s, m, h or d
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Signs the 5-minute links admins use to open private files (student ID cards).
# At least 32 characters and different from both JWT secrets.
FILE_SIGNING_SECRET=
# Folder for private uploads, relative to server/. Never served as static files.
# PRIVATE_STORAGE_DIR=storage/private

# Dev seed only (npm run db:seed): the SUPER_ADMIN account it creates.
# SEED_ADMIN_EMAIL=admin@unigo.local
# SEED_ADMIN_PASSWORD=
# Development only: the password of the two chat demo students made by
# `npm run db:seed:dev-chat -w server` (B2b). That script refuses to run unless
# NODE_ENV=development.
# DEV_DEMO_PASSWORD=

# Google sign-in: the OAuth web client ID (…apps.googleusercontent.com)
GOOGLE_CLIENT_ID=

# Email. Development prints every email (including reset links) to the console.
# Set EMAIL_TRANSPORT=smtp to send real email in development. Production always
# uses SMTP and needs all of the SMTP_* values and MAIL_FROM.
# EMAIL_TRANSPORT=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="UniGo <no-reply@unigo.app>"

# B2a Background jobs (BullMQ). Redis or Memurai must be running.
REDIS_URL=redis://localhost:6379

# B2c Web Push. Make a key pair with: npx web-push generate-vapid-keys
# Required in production. Without them in development, push is off (in-app and
# email notifications still work). The subject is a mailto: or https: address.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@unigo.app
