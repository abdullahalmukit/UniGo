{
  // For the editor and `npm run typecheck`: the source plus the seed scripts,
  // Prisma config and tests, so VS Code type-checks them with these settings
  // and picks up a regenerated Prisma client. The build uses tsconfig.build.json
  // (src only).
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["src", "prisma/**/*.ts", "prisma.config.ts", "tests", "vitest.config.ts"]
}
