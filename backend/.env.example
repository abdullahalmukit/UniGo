PORT=5000

# The website address (used for CORS)
CLIENT_URL=http://localhost:5173

# MySQL (the same server you open in MySQL Workbench)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=unigo_db

# Built from the values above. Leave this line as it is.
# If your password has special characters (@ # / : ? %), write them URL-encoded here, e.g. @ becomes %40
DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# Long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Google OAuth Web client ID (comma separated if you have more than one)
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com

# Used only by "npm run seed" to create the first admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
