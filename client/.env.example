# Copy this file to .env and change values if needed.

# Base URL of the API. "/api" uses the Vite dev proxy to http://localhost:4000.
VITE_API_URL=/api

# Google sign-in: the same OAuth web client ID as GOOGLE_CLIENT_ID in server/.env.
# Its "Authorised JavaScript origins" must include http://localhost:5173.
VITE_GOOGLE_CLIENT_ID=
